<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:padding="20dp">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/primary_accent"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAppSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/app_description"
        android:textColor="@color/text_medium_contrast"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle" />

    <!-- Current Mode Badge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardModeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/dark_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE MODE"
                android:textColor="@color/secondary_amber"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mode_assistant"
                android:textColor="@color/text_high_contrast"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModeDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Listening for voice queries and scanning path"
                android:textColor="@color/text_medium_contrast"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Camera & LiveKit System Indicators -->
    <LinearLayout
        android:id="@+id/layoutIndicators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cardModeStatus">

        <!-- Active Camera Card (Clickable to switch source) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCameraStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="@color/dark_surface"
            app:cardCornerRadius="12dp"
            app:strokeColor="#3300E5FF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvCameraTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE CAMERA"
                    android:textColor="@color/primary_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCameraStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/camera_status_phone_back"
                    android:textColor="@color/text_high_contrast"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCameraSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/camera_subtext_inactive"
                    android:textColor="@color/text_medium_contrast"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LiveKit Voice Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLiveKitStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="@color/dark_surface"
            app:cardCornerRadius="12dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvLiveKitTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOICE COMPANION"
                    android:textColor="@color/secondary_amber"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveKitStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/livekit_status_connected"
                    android:textColor="@color/text_high_contrast"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveKitSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tap to change server"
                    android:textColor="@color/text_medium_contrast"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Audio Level Meter -->
    <ai.drishti.ui.AudioLevelMeterView
        android:id="@+id/viewAudioLevelMeter"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutIndicators" />

    <!-- Camera Preview Viewport with Live Feed & Prominent Source Badge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCameraViewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#161616"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/btnEmergencySOS"
        app:layout_constraintTop_toBottomOf="@id/viewAudioLevelMeter">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Live Video Feed (Phone CameraX or ESP32-CAM MJPEG) -->
            <ImageView
                android:id="@+id/ivCameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Live Camera Feed"
                android:visibility="gone" />

            <!-- Standby / Inactive Placeholder -->
            <LinearLayout
                android:id="@+id/layoutCameraPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPlaceholderIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/tvPlaceholderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Camera Standby"
                    android:textColor="@color/text_high_contrast"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlaceholderDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap 'Start Drishti' below to start live vision"
                    android:textColor="@color/text_medium_contrast"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Prominent Floating Banner at Top of Video Viewport -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPreviewBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#E6101010"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeColor="#5500E5FF"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp">

                    <!-- Live Indicator Dot -->
                    <View
                        android:id="@+id/viewLiveIndicatorDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/indicator_dot_gray" />

                    <!-- Live Source Text -->
                    <TextView
                        android:id="@+id/tvLiveCameraBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT: PHONE (BACK) • STANDBY"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Floating Lens / Info Pill -->
            <TextView
                android:id="@+id/tvPreviewSourceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="#B3000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Source: Phone Built-in Camera • Tap to switch"
                android:textColor="@color/text_medium_contrast"
                android:textSize="11sp" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Emergency SOS Button (Large Accessible Target) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmergencySOS"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/alert_red"
        android:text="@string/trigger_emergency"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/layoutControls" />

    <!-- Primary Control Buttons -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleService"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary_accent"
            android:text="@string/start_service"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/dark_surface"
            android:text="@string/switch_camera"
            android:textColor="@color/text_high_contrast"
            app:cornerRadius="14dp"
            app:strokeColor="@color/text_medium_contrast"
            app:strokeWidth="1dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
