# ==============================================================================
# Drishti — Git Ignore Rules
# CRITICAL: Ensures no API keys, credentials, local paths, or build artifacts are leaked
# ==============================================================================

# ── Environment & Secrets (NEVER COMMIT) ──
*.env
*.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
credentials.json
client_secret*.json
google-services.json

# ── Android Build Artifacts & Machine Paths ──
android/.gradle/
android/build/
android/*/build/
android/local.properties
android/.idea/
android/*.iml
android/*/*.iml
.cxx/
*.apk
*.ap_
*.aab
*.dex
*.class
*.tflite.bin

# ── Python Environments & Caches ──
.venv/
*/.venv/
venv/
*/venv/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*/.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Node / Web Artifacts ──
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDEs & Operating System Artifacts ──
.idea/
*/.idea/
.vscode/
*/.vscode/
.DS_Store
Thumbs.db
*.log
.kilo/
.kombai/

# ── External / Separate Repositories ──
livekit-frontend-with-backend-for-use-anywhere-/

# ── Scratch & Temporary Agent Files ──
scratch/

